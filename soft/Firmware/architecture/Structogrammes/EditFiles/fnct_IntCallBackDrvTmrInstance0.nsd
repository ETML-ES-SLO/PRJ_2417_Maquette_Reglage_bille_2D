	<children>
		<instruction text="&#34;paramètres d'entrée :&#34;,&#34; - auncuns&#34;,&#34;&#34;,&#34;variables locals :&#34;,&#34;  - entier non-signée 32_bits :&#34;,&#34;      (static) CntInit&#34;,&#34;&#34;,&#34;  - entier non-signée 8_bits :&#34;,&#34;      (static) initMenu&#34;" comment="&#34;&#34;" color="c0c0c0" rotated="0" disabled="0"></instruction>
		<call text="&#34;RC7Toggle()&#34;" comment="&#34;&#34;" color="ff8000" disabled="0"></call>
		<instruction text="&#34;CntInit ++&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<alternative text="&#34;SI(CntInit == 300000 ET initMenu == 0)&#34;" comment="&#34;&#34;" color="ffff80" disabled="0">
			<qTrue>
				<call text="&#34;lcd_clear&#34;" comment="&#34;&#34;" color="80ffff" disabled="0"></call>
				<call text="&#34;menuInit&#34;" comment="&#34;&#34;" color="80ffff" disabled="0"></call>
				<instruction text="&#34;initMenu = 1&#34;" comment="&#34;&#34;" color="80ff80" rotated="0" disabled="0"></instruction>
			</qTrue>
			<qFalse color="ff80c0">
			</qFalse>
		</alternative>
		<alternative text="&#34;SI(CntInit &#62;= 300000)&#34;" comment="&#34;&#34;" color="ffff80" disabled="0">
			<qTrue>
				<instruction text="&#34;CntInit = 300000&#34;" comment="&#34;&#34;" color="80ff80" rotated="0" disabled="0"></instruction>
				<call text="&#34;APP_UpdateState (APP_STATE_SERVICE_TASKS)&#34;" comment="&#34;&#34;" color="80ffff" disabled="0"></call>
			</qTrue>
			<qFalse color="ff80c0">
